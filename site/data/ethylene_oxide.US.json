osure"}],"severe":true,"flash_point_C":-20,"autoignition_C":429,"LFL_pct":2.6,"UFL_pct":100.0,"Tb_C":11},{"id":"C2H4","name":"Ethylene","formula":"C2H4","cas":"74-85-1","ghs":[{"code":"H220","text":"Extremely flammable gas"},{"code":"H280","text":"Contains gas under pressure; may explode if heated"},{"code":"H336","text":"May cause drowsiness or dizziness"}],"severe":true,"flash_point_C":null,"autoignition_C":440,"LFL_pct":2.3,"UFL_pct":36.0,"Tb_C":-104},{"id":"O2","name":"Oxygen","formula":"O2","cas":"7782-44-7","ghs":[{"code":"H270","text":"May cause or intensify fire; oxidiser"},{"code":"H280","text":"Contains gas under pressure; may explode if heated"}],"severe":true,"flash_point_C":null,"autoignition_C":null,"LFL_pct":null,"UFL_pct":23.5,"Tb_C":-183},{"id":"CH4","name":"Methane","formula":"CH4","cas":"74-82-8","ghs":[{"code":"H220","text":"Extremely flammable gas"},{"code":"H280","text":"Contains gas under pressure; may explode if heated"}],"severe":true,"flash_point_C":null,"autoignition_C":600,"LFL_pct":4.4,"UFL_pct":17.0,"Tb_C":-161},{"id":"N2","name":"Nitrogen","formula":"N2","cas":"7727-37-9","ghs":[{"code":"H280","text":"Contains gas under pressure; may explode if heated"},{"code":"ASPH","text":"Simple asphyxiant in confined spaces"}],"severe":false,"flash_point_C":null,"autoignition_C":null,"LFL_pct":null,"UFL_pct":23.5,"Tb_C":-196},{"id":"Ar","name":"Argon","formula":"Ar","cas":"7440-37-1","ghs":[{"code":"H280","text":"Contains gas under pressure; may explode if heated"},{"code":"ASPH","text":"Simple asphyxiant in confined spaces"}],"severe":false,"flash_point_C":null,"autoignition_C":null,"LFL_pct":null,"UFL_pct":23.5,"Tb_C":-186},{"id":"CO2","name":"Carbon dioxide","formula":"CO2","cas":"124-38-9","ghs":[{"code":"H280","text":"Contains gas under pressure; may explode if heated"},{"code":"ASPH","text":"Simple asphyxiant in confined spaces"}],"severe":false,"flash_point_C":null,"autoignition_C":null,"LFL_pct":null,"UFL_pct":23.5,"Tb_C":-78},{"id":"H2O","name":"Water","formula":"H2O","cas":"7732-18-5","ghs":[],"severe":false,"flash_point_C":null,"autoignition_C":null,"LFL_pct":null,"UFL_pct":23.5,"Tb_C":100}],"hazop":[{"node":"Oxygen mixing station","deviation":"High oxygen concentration","cause":"Oxygen flow control fault or loss of ethylene","consequence":"Cycle gas inside the flammable envelope, deflagration in the reactor or piping","safeguard":"Online O2 analysers with fast trip of the oxygen supply, mixing nozzle design, flame arresters"},{"node":"EO reactor","deviation":"High temperature","cause":"Loss of shell side water level, catalyst runaway","consequence":"Runaway combustion, tube damage","safeguard":"Steam drum level trips, temperature trips, inhibitor dosing"},{"node":"EO refining and storage","deviation":"Contamination","cause":"Rust, caustic or acid traces in storage","consequence":"Runaway polymerisation or decomposition of liquid EO","safeguard":"Stainless steel, nitrogen padding, refrigeration, temperature monitoring, water deluge"},{"node":"EO handling","deviation":"Loss of containment","cause":"Seal or flange failure","consequence":"Toxic, carcinogenic and highly flammable vapour release","safeguard":"Sealless pumps, gas detection, water curtains, remote isolation"}],"process_hazards":[{"hazard":"Pressure","detail":"Up to 22 bar. Relief valves sized for fire and blocked outlet."},{"hazard":"Flammable materials","detail":"Ethylene oxide, Ethylene, Methane. Hazardous area classification, ignition source control, gas detection, fire protection."},{"hazard":"Toxic materials","detail":"Ethylene oxide. Toxic gas detection, emergency shutdown and isolation, escape sets, minimise inventory."},{"hazard":"Corrosive materials","detail":"Ethylene oxide. Material selection, PPE, safety showers, bunded storage."}],"validation":[{"metric":"Ethylene use at 80% selectivity, oxygen process","model":0.817723,"published":0.8,"unit":"t C2H4 / t EO","error_pct":2.215421,"inside_range":null,"source":"IPCC 2006 Guidelines, Vol 3 Ch 3, Table 3.20 (from the EU IPPC LVOC BAT document)","url":"https://www.ipcc-nggip.iges.or.jp/public/2006gl/pdf/3_Volume3/V3_3_Ch3_Chemical_Industry.pdf","note":"Model includes the ethylene lost in the purge gas.","kind":"process","tolerance_pct":3,"pass":true},{"metric":"CO2 at 80% selectivity, oxygen process","model":0.498246,"published":0.5,"unit":"t CO2 / t EO","error_pct":-0.350792,"inside_range":null,"source":"IPCC 2006 Guidelines, Vol 3 Ch 3, Table 3.20 (from the EU IPPC LVOC BAT document)","url":"https://www.ipcc-nggip.iges.or.jp/public/2006gl/pdf/3_Volume3/V3_3_Ch3_Chemical_Industry.pdf","note":"CO2 removed in the hot carbonate unit; the purge carries a little more, which is burnt.","kind":"process","tolerance_pct":5,"pass":true},{"metric":"Electricity use, excluding oxygen supply","model":348.600658,"published":[360,627],"unit":"Btu/lb EO","error_pct":-3.166484,"inside_range":false,"source":"US DOE, Energy and Environmental Profile of the US Chemical Industry (2000), Table 2-5","url":"https://www.osti.gov/servlets/purl/1218625","note":"US 1997 range. DOE counts the energy to make the oxygen as feedstock energy, so the ASU compressors are left out here. The DOE table describes an air based plant, which needs extra purge compression; an oxygen plant is expected at or below the low end.","kind":"process","tolerance_pct":10,"pass":true}],"assumptions":["Catalyst selectivity 80% (IPCC Table 3.20 gives 75 to 85% for the oxygen process). Small losses to acetaldehyde and to glycol in the stripper are not modelled.","Cycle gas composition, per pass conversion and space velocity are typical published ranges, not one plant's data.","Oxygen from an on-site cryogenic ASU at 99.5% purity; the argon it carries sets the purge.","CO2 removed in a hot potassium carbonate unit using 2.8 GJ of steam per t CO2.","Reactor heat raises saturated 40 bar steam on the shell side, credited at the regional steam price.","The purge is burnt in the site fuel system; methane ballast make up is bought as natural gas.","Product is high purity EO; no ethylene glycol unit is attached."],"notes":[]}